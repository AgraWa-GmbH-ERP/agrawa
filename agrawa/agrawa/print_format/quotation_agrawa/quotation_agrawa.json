 "html": "<!-- LETTER HEAD -->\n{% if letter_head %}\n<div class=\"print-format-header\" id=\"header-html\" style=\"height:45mm; overflow:hidden; padding:0; margin:0;\">\n    {{ letter_head }}\n</div>\n{% endif %}\n\n<!-- Address + Company info section -->\n<div style=\"display: flex; justify-content: space-between; align-items: flex-start; height:45mm;\">\n\n    <!-- Left side (address block inside window) -->\n    <div style=\"text-align: left; width: 8.5cm; height: 100%; margin-left: 10mm;\">\n        <span style=\"color: #A11929;\">AgraWa GmbH</span> \n        <span style=\"color: green;\">|</span> \n        <span style=\"color: #A11929;\">Sonnenbergstr. 17/1</span> \n        <span style=\"color: green;\">|</span> \n        <span style=\"color: #A11929;\">71665 Vaihingen/Enz</span>\n        \n        <div style=\"margin-top: 0.2cm;\">\n            <strong>{{ doc.customer_name }}</strong><br>\n            {% if doc.address_display %}\n                {{ doc.address_display }}\n            {% endif %}\n        </div>\n    </div>\n\n    <!-- Right side (company info) -->\n    <div style=\"text-align: left; font-size: 11px; line-height: 1.5; margin-left: auto; margin-right:20mm;  height: 100%;\">\n        <span style=\"color: #A11929;\"><b>AgraWa GmbH</b></span><br>\n        Sonnenbergstr. 17/1 <br>\n        D-71665 Vaihingen/Enz <br>\n        Mobil: +49 176 17942780 <br>\n        Tel.: +49 7042 2763572 <br>\n        Mail: <a href=\"mailto:info@agrawa.de\">info@agrawa.de</a>\n    </div>\n</div>\n\n<!-- BODY Wrapper -->\n<div style=\"margin-left: 10mm; margin-right: 10mm;\">\n\n    <div style=\"display: flex; justify-content: space-between; align-items: flex-start;\">\n        <!-- Left side -->\n        <h1><b>ANGEBOT</b></h1>\n\n        <!-- Right side -->\n        <div style=\"text-align: left; font-size: 12px; line-height: 1.6; margin-left: auto;\">\n            <b>Angebotsnr.: </b>{{doc.name}}<br>\n            <b>Angebotsdatum: </b>{{doc.transaction_date}}<br>\n            {% if doc.custom_delivery_date %}\n                <b>Lieferdatum: </b>{{ doc.custom_delivery_date }}<br>\n            {% endif %}\n            <b>Kundennr.: </b>{{doc.party_name}}<br>\n            <b>Ihr Ansprechpartner: </b>Herr Schweikart<br>+49 176 17942780<br>\n        </div>\n    </div>\n    <br>\n\n    {% if doc.contact_person %}\n        {% set contact = frappe.get_doc(\"Contact\", doc.contact_person) %}\n        Sehr geehrter {{contact.salutation or \"\"}} {{ contact.last_name or \"\" }},\n    {% else %}\n        Sehr geehrter Damen und Herren,\n    {% endif %}\n\n    <br>\n    vielen Dank f\u00fcr Ihr Interesse. Ich freue mich sehr, Ihnen das folgende Angebot unterbreiten zu k\u00f6nnen:\n    Das Angebot ist freibleibend.\n    <br><br>\n\n    <table class=\" table-sm pricetable\" >\n\t<thead>\n\t\t<tr class=\"\">\n\t\t\t<th width=\"5%\">{{ _(\"Pos.\") }}</th>\n\t\t\t<th width=\"15%\">{{ _(\"Item Name\") }}</th>\n\t\t\t<th width=\"20%\">{{ _(\"Description\") }}</th>\n\t\t\t<th width=\"5%\">{{ _(\"Packing Unit\") }}</th>\n\t\t\t<th width=\"5%\">{{ _(\"Item Number\") }}</th>\n\t\t\t<th width=\"5%\">{{ _(\"Tax\") }}</th>\n    \t\t<th width=\"10%\" class=\"text-right\">{{ _(\"Sales Price\") }}</th>\n\t\t\t<th width=\"5%\" class=\"text-right\">{{ _(\"Amount\") }}</th>\n\t\t\t<th width=\"5%\" class=\"text-right\">{{ _(\"Pricing Unit\") }}</th>\n\t\t\t<th width=\"10%\" class=\"text-right\">{{ _(\"Total Amount\") }}</th>\n\t\t</tr>\n\t</thead>\n    <tbody>\n        {% for item in doc.items %}\n        <tr>\n            <td>{{ loop.index }}</td>\n            <td>{{ item.item_name or '' }}</td>\n            <td>{{ item.description or '' }}</td>\n            <td>{{ frappe.db.get_value(\"Item\", item.item_code, \"custom_packaging_unit\") or '' }}</td>\n            <td>{{ item.item_code }}</td>\n            <td>{{ item.item_tax_template.split('-')[0].strip() }}</td>\n            <td class=\"text-right\">{{ \"{:,.2f}\".format(item.rate) }}</td>\n            <td class=\"text-right\">{{ item.qty }}</td>\n            <td>{{ item.stock_uom or '' }}</td>\n            <td class=\"text-right\">{{ \"{:,.2f}\".format(item.amount) }}</td>\n        </tr>\n        {% endfor %}\n        <!-- Net Amount -->\n        <tr>\n            <td colspan=\"9\" class=\"text-right\"><b>{{ _(\"Net Amount\") }}</b></td>\n            <td class=\"text-right\"><b>{{ doc.get_formatted(\"total\") }}</b></td>\n        </tr>\n        <!-- Tax Row -->\n        <tr>\n            <td colspan=\"9\" class=\"text-right\"><b>{{ _(\"Additional VAT\") }}</b></td>\n            <td class=\"text-right\"><b>{{ doc.get_formatted(\"total_taxes_and_charges\") }}</b></td>\n        </tr>\n\n        <!-- Grand Total Row -->\n        <tr>\n            <td colspan=\"9\" class=\"text-right\"><b>{{ _(\"Grand Total\") }}</b></td>\n            <td class=\"text-right\"><b>{{ doc.get_formatted(\"grand_total\") }}</b></td>\n        </tr>\n\n    </tbody>\n</table>\n\n    <br>\n    <div style=\"page-break-inside: avoid;\">\n        <p>\n            <b>{{ doc.tc_name or '' }}</b><br>\n            {{ doc.terms or ''}}\n        </p>\n    </div>\n\n    <!-- Greeting -->\n    <div style=\"width: 100%; margin-bottom: 10px; page-break-inside: avoid;\">\n        Wir freuen uns, sollte dieses Angebot Ihre Zustimmung finden. Bei R\u00fcckfragen stehen wir Ihnen gerne zur Verf\u00fcgung. <br>\n        Mit freundlichen Gr\u00fc\u00dfen: \n        <div style=\"flex: 0 0 auto; margin-right: 20px; text-align: left;\">\n            <img src=\"/files/image1-23.png\" alt=\"Logo\" style=\"width: 150px; height: auto;\">\n        </div>\n        Steffen Schweikart\n    </div>\n\n</div>\n\n    <br>\n<!--Footer-->\n<div id=\"footer-html\" class=\"visible-pdf\">\n    <div class=\"print-format-footer\">\n        {{ footer }}\n    </div>\n</div>",
